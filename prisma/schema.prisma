// Slotsmith: appointment booking starter kit.
// SQLite by default (zero setup). To use Postgres, change provider to "postgresql"
// and set DATABASE_URL. See docs/DEPLOY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Single-row business settings (id is always 1).
model Settings {
  id                Int    @id @default(1)
  businessName      String @default("Slotsmith Studio")
  tagline           String @default("Book your appointment online in under a minute.")
  timezone          String @default("America/New_York")
  currency          String @default("USD")
  slotIntervalMin   Int    @default(15)
  bufferMin         Int    @default(0)
  minNoticeHours    Int    @default(2)
  maxDaysAhead      Int    @default(30)
  cancelCutoffHours Int    @default(12)
  contactEmail      String @default("hello@example.com")
}

model Service {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String         @default("")
  durationMin  Int
  priceCents   Int            @default(0)
  depositCents Int            @default(0)
  active       Boolean        @default(true)
  sortOrder    Int            @default(0)
  staff        StaffService[]
  bookings     Booking[]
  createdAt    DateTime       @default(now())
}

model Staff {
  id           String         @id @default(cuid())
  name         String
  email        String         @default("")
  bio          String         @default("")
  active       Boolean        @default(true)
  services     StaffService[]
  availability Availability[]
  timeOff      TimeOff[]
  bookings     Booking[]
  createdAt    DateTime       @default(now())
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

/// Weekly working hours in the business timezone. weekday: 0 = Sunday.
/// startMin/endMin are minutes after local midnight (e.g. 540 = 09:00).
model Availability {
  id       String @id @default(cuid())
  staffId  String
  weekday  Int
  startMin Int
  endMin   Int
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

model TimeOff {
  id       String   @id @default(cuid())
  staffId  String
  startsAt DateTime
  endsAt   DateTime
  reason   String   @default("")
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
}

/// status: PENDING_PAYMENT | CONFIRMED | CANCELLED
/// paymentStatus: NONE | PENDING | PAID
model Booking {
  id              String    @id @default(cuid())
  serviceId       String
  staffId         String
  customerName    String
  customerEmail   String
  customerPhone   String    @default("")
  notes           String    @default("")
  startsAt        DateTime
  endsAt          DateTime
  status          String    @default("CONFIRMED")
  paymentStatus   String    @default("NONE")
  priceCents      Int       @default(0)
  depositCents    Int       @default(0)
  stripeSessionId String?
  manageToken     String    @unique
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  service         Service   @relation(fields: [serviceId], references: [id])
  staff           Staff     @relation(fields: [staffId], references: [id])

  @@index([staffId, startsAt])
  @@index([status, startsAt])
}
