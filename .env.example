# --- Required ---
# SQLite file (zero setup). For Postgres, see README "Deploying".
DATABASE_URL="file:./dev.db"
# Public URL of your site, used in links inside emails.
APP_URL="http://localhost:3000"
# Admin dashboard login at /admin
ADMIN_PASSWORD="change-me"
# Random string, 16+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (optional; without it, emails are printed to the server log) ---
# Any SMTP provider works: Resend, Postmark, SendGrid, Mailgun, Gmail app password...
# SMTP_URL="smtps://USER:PASSWORD@smtp.example.com:465"
# MAIL_FROM="Your Studio <bookings@yourdomain.com>"


